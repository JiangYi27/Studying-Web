<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>重置密码 · 研习室</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Noto+Serif+SC:wght@500;600;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --ink: #152238;
      --muted: #667085;
      --white: #ffffff;
      --line: #dce1e5;
      --orange: #f26b4f;
      --teal: #2b8c88;
      --red: #ef4444;
      --green: #48a868;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Noto Serif SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f0f4f8 0%, #e8edf2 100%);
    }
    .reset-card {
      width: 100%; max-width: 400px;
      padding: 34px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--white);
      box-shadow: 0 18px 55px rgba(21, 34, 56, 0.08);
      position: relative; overflow: hidden;
    }
    .reset-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--teal), var(--orange));
    }
    .reset-card h2 { margin: 0 0 6px; font-size: 22px; letter-spacing: -0.03em; }
    .reset-card p { margin: 0 0 20px; color: var(--muted); font-size: 13px; }
    .field { margin-bottom: 14px; }
    .field label { display: block; margin-bottom: 6px; color: var(--ink); font-size: 12px; font-weight: 750; }
    .field input {
      width: 100%; height: 46px; padding: 0 14px;
      border: 1.5px solid var(--line); border-radius: 8px;
      outline: none; color: var(--ink); background: var(--white);
      font-size: 14px; transition: border-color 200ms, box-shadow 200ms;
    }
    .field input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(43, 140, 136, 0.12); }
    .submit {
      width: 100%; height: 48px; border: 0; border-radius: 8px;
      color: var(--white);
      background: linear-gradient(135deg, var(--orange), #dc573d);
      font-size: 14px; font-weight: 800; letter-spacing: 0.04em;
      cursor: pointer; transition: all 200ms ease;
      box-shadow: 0 4px 14px rgba(242,107,79,0.35);
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .submit:hover { transform: translateY(-2px); }
    .submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .notice { min-height: 18px; margin-top: 12px; font-size: 12px; text-align: center; }
    .notice.error { color: var(--red); }
    .notice.success { color: var(--green); }
    .back-link {
      display: block; text-align: center; margin-top: 16px;
      color: var(--teal); font-size: 13px; font-weight: 700;
      text-decoration: none; cursor: pointer;
    }
    .back-link:hover { text-decoration: underline; }
    .brand { text-align: center; margin-bottom: 24px; }
    .brand a { color: var(--ink); font-size: 24px; text-decoration: none; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; }
  </style>
</head>
<body>
  <div class="reset-card">
    <div class="brand"><a href="/">研习室</a></div>

    <div id="stepVerify" style="display:none;">
      <div style="text-align:center; padding:20px 0;">
        <i class="fas fa-spinner fa-spin" style="font-size:24px; color:var(--teal);"></i>
        <p style="margin-top:12px;">验证重置链接...</p>
      </div>
    </div>

    <div id="stepForm">
      <h2>设置新密码</h2>
      <p>请输入您的新密码（至少 6 位）。</p>

      <div class="field">
        <label for="newPassword">新密码</label>
        <input id="newPassword" type="password" placeholder="至少 6 个字符" minlength="6" required />
      </div>
      <div class="field">
        <label for="confirmPassword">确认密码</label>
        <input id="confirmPassword" type="password" placeholder="再次输入密码" required />
      </div>
      <button class="submit" type="button" id="resetBtn">
        <i class="fas fa-check"></i>
        重置密码
      </button>
      <div class="notice" id="resetNotice" aria-live="polite"></div>
      <a href="/" class="back-link">返回登录</a>
    </div>

    <div id="stepSuccess" style="display:none; text-align:center;">
      <i class="fas fa-check-circle" style="font-size:48px; color:var(--green); margin-bottom:12px;"></i>
      <h2>密码重置成功</h2>
      <p style="margin-top:8px;">请使用新密码登录。</p>
      <a href="/" class="back-link" style="margin-top:20px;">前往登录</a>
    </div>

    <div id="stepError" style="display:none; text-align:center;">
      <i class="fas fa-exclamation-circle" style="font-size:48px; color:var(--red); margin-bottom:12px;"></i>
      <h2>链接无效</h2>
      <p id="stepErrorMsg" style="margin-top:8px;">重置链接无效或已过期。</p>
      <a href="/" class="back-link" style="margin-top:20px;">返回登录</a>
    </div>
  </div>

  <script>
    var token = '<%= typeof token === "string" ? token.replace(/'/g, "\\'") : "" %>';
    if (!token) {
      document.getElementById('stepError').style.display = 'block';
      document.getElementById('stepErrorMsg').textContent = '缺少重置令牌。';
    } else {
      // 验证 token 有效性
      document.getElementById('stepVerify').style.display = 'block';
      document.getElementById('stepForm').style.display = 'none';
      var xhr = new XMLHttpRequest();
      xhr.open('GET', '/api/auth/verify-reset-token?token=' + encodeURIComponent(token), true);
      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
          document.getElementById('stepVerify').style.display = 'none';
          if (xhr.status === 200) {
            document.getElementById('stepForm').style.display = 'block';
          } else {
            var msg = '重置链接无效或已过期。';
            try { var data = JSON.parse(xhr.responseText); msg = data.error || msg; } catch(_) {}
            document.getElementById('stepError').style.display = 'block';
            document.getElementById('stepErrorMsg').textContent = msg;
          }
        }
      };
      xhr.send();
    }

    document.getElementById('resetBtn').addEventListener('click', function() {
      var newPw = document.getElementById('newPassword').value;
      var confirmPw = document.getElementById('confirmPassword').value;
      var notice = document.getElementById('resetNotice');

      if (newPw.length < 6) { notice.textContent = '新密码至少 6 位'; notice.className = 'notice error'; return; }
      if (newPw !== confirmPw) { notice.textContent = '两次密码不一致'; notice.className = 'notice error'; return; }

      notice.textContent = '';
      notice.className = 'notice';
      var btn = document.getElementById('resetBtn');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 重置中...';

      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/auth/reset-password', true);
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-check"></i> 重置密码';
          if (xhr.status === 200) {
            document.getElementById('stepForm').style.display = 'none';
            document.getElementById('stepSuccess').style.display = 'block';
          } else {
            var msg = '重置失败，请重试';
            try { var data = JSON.parse(xhr.responseText); msg = data.error || msg; } catch(_) {}
            notice.textContent = msg;
            notice.className = 'notice error';
          }
        }
      };
      xhr.send(JSON.stringify({ token: token, newPassword: newPw }));
    });
  </script>
</body>
</html>