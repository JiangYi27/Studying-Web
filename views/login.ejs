  <script>
    /* ── 动态生成登录页视频 ── */
    (function () {
      var container = document.getElementById('loginHeroVideos');
      if (container && window.LOGIN_VIDEOS) {
        window.LOGIN_VIDEOS.forEach(function(v, i) {
          var video = document.createElement('video');
          video.className = 'login-hero-video' + (i === 0 ? ' active' : '');
          video.src = v.src;
          video.autoplay = true;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.setAttribute('preload', i === 0 ? 'auto' : 'none');
          container.appendChild(video);
        });
      }
    })();
  </script>
  <script>
    /* ── 介绍 Modal 逻辑 ── */
    (function () {
      /* 动态填充课程地图章节列表 */
      (function buildCurriculum() {
        var list = document.getElementById('introChaptersList');
        if (!list) return;
        var chapters = [
          { site: 'C语言', icon: '💻', items: [
            'C语言概述', '核心语法基础', '程序流程控制',
            '数组与字符串', '函数与程序结构', '指针',
            '内存管理', '构造数据类型', 'C预处理器',
            '标准库与系统调用', '文件操作', '高级与底层专题',
            '数据结构与算法', '工程化与调试'
          ]},
          { site: '英语语法', icon: '📖', items: [
            '重塑语法认知框架', '动词语气与虚拟语气',
            '从句', '词类', '句子成分与分类'
          ]}
        ];
        chapters.forEach(function (ch) {
          ch.items.forEach(function (title) {
            var card = document.createElement('div');
            card.className = 'intro-chapter-card';
            card.innerHTML = '<span class="ch-icon">' + ch.icon + '</span>' + title +
              '<span class="ch-title">' + ch.site + '</span>';
            list.appendChild(card);
          });
        });
      })();

      /* 打开 / 关闭 Modal */
      function openModal(id) {
        var modal = document.getElementById(id);
        if (modal) modal.classList.add('open');
      }
      function closeModal(id) {
        var modal = document.getElementById(id);
        if (modal) modal.classList.remove('open');
      }
      function closeAllModals() {
        document.querySelectorAll('.intro-modal.open').forEach(function (m) {
          m.classList.remove('open');
        });
      }

      /* 点击关闭按钮或遮罩关闭 */
      document.addEventListener('click', function (e) {
        if (e.target.hasAttribute('data-close-modal')) {
          closeAllModals();
        }
      });

      /* ESC 键关闭 */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAllModals();
      });

      /* 给导航链接绑定打开事件 */
      var overlay = document.getElementById('loginBg');
      if (overlay) {
        overlay.addEventListener('click', function (e) {
          var target = e.target.closest('[data-modal]');
          if (target) {
            openModal(target.getAttribute('data-modal'));
          }
        });
      }

      /* 给移动菜单链接也绑定 */
      var menuOverlay = document.getElementById('loginMenuOverlay');
      if (menuOverlay) {
        menuOverlay.addEventListener('click', function (e) {
          var link = e.target.closest('a[data-modal]');
          if (link) {
            link.addEventListener('click', function (ev) {
              ev.preventDefault();
              openModal(link.getAttribute('data-modal'));
            });
          }
        });
      }
    })();
  </script>
